rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Qualquer pessoa com o link pode ver o planejamento.
    // Só o e-mail abaixo, logado, pode criar, editar ou apagar.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "SEU_EMAIL_AQUI";
    }
  }
}
